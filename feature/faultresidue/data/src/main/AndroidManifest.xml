<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
        Startup side effect only: the framework installs providers on the main thread after
        Application.attachBaseContext and before Application.onCreate, which is the earliest point
        a manifest-declared component can read the main thread's inherited kernel fault record.
        The record lives in one per-thread slot that any later promoted exception overwrites, so
        the reading has to be captured here rather than at scan time. Not exported and serving no
        URI. A higher initOrder moves it ahead of providers that would otherwise run first.
        -->
        <provider
            android:name="com.eltavine.duckdetector.features.faultresidue.data.early.FaultResidueSamplingProvider"
            android:authorities="${applicationId}.faultresidue.sampler"
            android:exported="false"
            android:initOrder="1000" />
    </application>

</manifest>
